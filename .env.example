APP_NAME="Ani-Mart"
APP_URL=http://localhost/ani-mart/public
APP_ENV=development
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ani_mart
DB_USERNAME=root
DB_PASSWORD=

# Optional in development. When omitted, Ani-Mart creates a protected key file
# under storage/private/keys. Production deployments should inject this secret.
DATA_ENCRYPTION_KEY_BASE64=

ANI_MART_DEFAULT_LATITUDE=10.2833
ANI_MART_DEFAULT_LONGITUDE=125.1700

AI_FARMER_VERIFICATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FARMER_VERIFICATION_MODEL=gemini-3.6-flash

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Ani-Mart"

# Required for password-reset email and optional administrator login codes.
# Administrators can enable login codes from their profile after email is configured.
